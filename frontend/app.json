{
  "expo": {
    "name": "frontend",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.mobilebuild.nisw6b",
      "infoPlist": {
        "NSCameraUsageDescription": "Take photos of custom hand signs to add to your library",
        "NSPhotoLibraryUsageDescription": "Pick a reference photo for custom signs",
        "NSLocalNetworkUsageDescription": "Connect to your ESP32 glove over Wi-Fi"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.emergent.mobilebuild.nisw6b",
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "BLUETOOTH_SCAN",
        "BLUETOOTH_CONNECT",
        "ACCESS_FINE_LOCATION",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "expo-audio",
      "expo-camera",
      "expo-image-picker",
      "@sfourdrinier/react-native-ble-plx"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
